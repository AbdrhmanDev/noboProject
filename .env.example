VITE_API_BASE_URL=
# Set to true once the backend exposes POST /sales-orders/{id}/merge (POS "merge tables").
VITE_FEATURE_TABLE_MERGE=false
# Development-only scale-reading simulator in the POS weight-entry dialog. No real scale
# integration exists yet -- leave false in every normal build.
VITE_SCALE_SIMULATOR_ENABLED=false
# Connects the POS weight-entry dialog to the Edge Agent's real local scale bridge (Phase F.3).
# Only takes effect when VITE_DEPLOYMENT_MODE=SelfHosted -- a Cloud deployment ignores this.
VITE_SCALE_BRIDGE_ENABLED=false
# Must match the Edge Agent's own EdgeAgentOptions.ScaleBridge.Port (default 47811).
VITE_SCALE_BRIDGE_URL=http://127.0.0.1:47811
